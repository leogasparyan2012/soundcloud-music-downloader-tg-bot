# Скопируйте этот файл в .env и заполните значения.
# Обязательный параметр — только BOT_TOKEN.

# Токен бота от @BotFather (https://t.me/BotFather)
BOT_TOKEN=123456789:AAH...

# Куда складывать временные файлы (удаляются после отправки)
DOWNLOAD_DIR=downloads

# Битрейт итогового MP3: 128, 192, 256 или 320
AUDIO_QUALITY=320

# Лимит размера файла в МБ (облачный Telegram Bot API принимает до 50 МБ)
MAX_FILE_MB=50

# Сколько треков максимум качать из одного плейлиста (1–500)
MAX_PLAYLIST_ITEMS=500

# Сколько загрузок выполнять одновременно (1–10)
MAX_CONCURRENT_DOWNLOADS=2

# Таймаут одной загрузки в секундах (30–3600)
DOWNLOAD_TIMEOUT=900

# Необязательно: cookies.txt для приватных/возрастных треков (формат Netscape)
COOKIES_FILE=

# Необязательно: прокси для загрузки, например http://user:pass@host:8080
PROXY=

# Необязательно: адрес локального Telegram Bot API server (снимает лимит 50 МБ)
# TELEGRAM_API_URL=http://127.0.0.1:8081

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
